# Copy to .env and fill in. .env is gitignored.

# ==========================================================================
# Which model serves the AI features
# ==========================================================================
# gemini | ollama | anthropic | auto
# `auto` uses the first one that is configured, preferring free and keyless:
# Gemini, then Ollama, then Anthropic.
COMPASS_LLM_PROVIDER=auto

# Effort per call: low | medium | high | xhigh | max
# On Gemini and Ollama this maps onto temperature (lower = less invention).
COMPASS_EFFORT=high

# --- Google Gemini -- free tier, no card required -------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verified working with structured output on a fresh free-tier key.
# `gemini-2.5-flash` still appears in /models but 404s for new accounts - being
# listed is not being usable. The free tier allows 20 requests per day PER MODEL,
# so when one is spent, switching the model here is the fix.
COMPASS_GEMINI_MODEL=gemini-3.5-flash

# --- Ollama -- fully local, no key, no network ----------------------------
# Install from https://ollama.com, then:  ollama pull llama3.2:3b
COMPASS_OLLAMA_HOST=http://localhost:11434
# 3B rather than 7B/8B on purpose: on a 4-core laptop with no usable GPU,
# anything larger takes minutes per generation.
COMPASS_OLLAMA_MODEL=llama3.2:3b
# Compass sends 5-8k tokens of profile + résumé + JD. Ollama defaults to 2048,
# which would silently truncate the prompt and produce confident nonsense.
COMPASS_OLLAMA_NUM_CTX=8192

# --- Anthropic -- best quality, paid --------------------------------------
# Either set this, or run `ant auth login` and leave it blank; the SDK resolves
# an OAuth profile automatically when ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=
# Model used for every LLM task. Do not append a date suffix.
COMPASS_MODEL=claude-opus-5

# --- App ---
# Leave this commented out. The default is an absolute path to compass.db in the
# project root; a relative URL like `sqlite:///./compass.db` resolves against the
# current working directory, so launching from elsewhere would silently open a
# different, empty database.
# COMPASS_DB_URL=sqlite:///C:/path/to/compass.db
#
# Point this at a managed Postgres when the host has NO PERSISTENT DISK - a free
# tier restarts and the SQLite file is gone, taking every account with it. That
# makes open registration actively harmful there: someone signs up, uploads a
# real CV, and loses it on the next restart.
#
# Neon's free tier needs no card and does not expire (neon.tech). Requires
# `psycopg[binary]`, which requirements.txt lists. app/db.py switches to
# connection pooling with pre-ping automatically, because a serverless Postgres
# scales to zero and a pooled connection held across that is dead.
# COMPASS_DB_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
COMPASS_HOST=127.0.0.1
COMPASS_PORT=8000

# Signs the session cookie. GENERATE THIS before exposing Compass to anything
# other than localhost - the default in app/config.py is published in a public
# repository, so leaving it in place makes every session cookie forgeable by
# anyone who reads it. Compass refuses to start if you bind non-locally without
# changing it.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
COMPASS_SECRET_KEY=change-me-to-a-random-string

# --- Open registration (see docs/CONSTRAINTS.md §1.2) ---
# Lets strangers create their own accounts. OFF by default, and turning it on is
# a decision about obligations rather than convenience: the instance then holds
# other people's employment history, which makes you the data fiduciary for it.
#
# What Compass enforces when it is on: a registered account is never an admin and
# never uncapped, registration is throttled per source address, the disclosure
# above the form must be acknowledged, and /account/delete genuinely erases.
#
# What it does not do: encryption at rest, email verification, password reset.
COMPASS_OPEN_SIGNUP=false
# Ceiling on total accounts, so a public instance cannot be filled overnight.
# 0 disables the limit.
COMPASS_MAX_ACCOUNTS=200
# Monthly AI budget a self-registered account starts with. It spends YOUR API
# key, so this is the number that bounds the bill.
COMPASS_SIGNUP_BUDGET_USD=1.00

# --- Public demo (see deploy/huggingface/README-DEPLOY.md) ---
# Seeds ONE non-admin, spend-capped account with published credentials, and
# shows them on the sign-in page — so a visitor to a public deployment can get
# past the invite-only wall. It only touches a database with no accounts in it,
# but leave this false on any instance holding your real career data.
COMPASS_DEMO_MODE=false

# --- Transport security (see docs/SECURITY.md) ---
# Marks the session cookie Secure and sends HSTS. Set true when serving over
# TLS; it MUST stay false for local http or the browser drops the cookie and
# login silently does nothing.
COMPASS_HTTPS_ONLY=false
# Sessions expire after this long, so a stolen cookie ages out.
COMPASS_SESSION_MAX_AGE_DAYS=14
# Upload ceiling, enforced while streaming rather than after reading the body.
COMPASS_MAX_UPLOAD_MB=10

# Cache identical LLM calls in SQLite so re-scoring a JD costs nothing.
COMPASS_LLM_CACHE=true

# --- Embeddings (JD-match semantic layer) ---
COMPASS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Warm the model on a background thread at startup (~45s, non-blocking) so the
# first JD scoring request is instant. Set false if you run with --reload and
# don't want that repeated on every code change.
COMPASS_PRELOAD_EMBEDDINGS=true
# Uncomment once the model has been downloaded once. It stops sentence-transformers
# revalidating its cache against Hugging Face on every start - faster, quieter,
# and genuinely offline.
# HF_HUB_OFFLINE=1

# --- Google OAuth (Epic E) ---
# See docs/GOOGLE_OAUTH_SETUP.md. Point this at the JSON you download from
# Google Cloud Console, or set the two values inline instead.
COMPASS_GOOGLE_CLIENT_SECRETS_FILE=./secrets/google_client_secret.json
COMPASS_GOOGLE_CLIENT_ID=
COMPASS_GOOGLE_CLIENT_SECRET=
COMPASS_GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# How far back Gmail sync looks on each run.
COMPASS_GMAIL_LOOKBACK_DAYS=30

# --- Quality gate (Epic D) ---
# Compare each new application against this many recent ones.
COMPASS_QUALITY_WINDOW=5
# Mean cover-letter similarity above this = "trending templated".
COMPASS_TEMPLATED_THRESHOLD=0.85
