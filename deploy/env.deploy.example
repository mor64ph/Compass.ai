# Copy to `.env.deploy` in the project root on the server, then fill in.
#
#   cp deploy/env.deploy.example .env.deploy
#
# This file is gitignored. It is the only place secrets live on the server, and
# .dockerignore keeps it out of the image - a secret baked into a layer is
# recoverable from `docker history` forever, even if a later layer deletes it.

# ==========================================================================
# Required
# ==========================================================================

# The hostname Caddy will request a certificate for. Must already resolve to
# this server's public IP before the first `up`, or the ACME challenge fails.
COMPASS_DOMAIN=compass.example.com

# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.com

# Signs session cookies. Compass REFUSES TO START without a real value when
# bound to anything other than loopback - the default in app/config.py is
# published in a public repository, so keeping it would let anyone who reads the
# repo forge a session cookie for the admin account.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
COMPASS_SECRET_KEY=

# ==========================================================================
# AI provider - at least one, or the deterministic half runs alone
# ==========================================================================

# Free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
COMPASS_LLM_PROVIDER=gemini
COMPASS_GEMINI_MODEL=gemini-3.5-flash

# Optional. Better output, costs money.
# ANTHROPIC_API_KEY=
# COMPASS_MODEL=claude-opus-5

# ==========================================================================
# Optional
# ==========================================================================

# Per-invitee monthly ceiling. Irrelevant on Gemini's free tier, which is
# rate-limited rather than metered, and priced at zero in app/services/usage.py.
# COMPASS_DEFAULT_BUDGET_USD=5.00

# Google integration. The redirect URI must match your real domain, and must be
# registered in the Google Cloud console. See docs/GOOGLE_OAUTH_SETUP.md.
# COMPASS_GOOGLE_CLIENT_ID=
# COMPASS_GOOGLE_CLIENT_SECRET=
# COMPASS_GOOGLE_REDIRECT_URI=https://compass.example.com/google/callback

# Session lifetime. Shorten it if the instance is shared with people you trust
# less than yourself.
# COMPASS_SESSION_MAX_AGE_DAYS=14

# Quality gate. Raising the threshold makes the gate more permissive, which is
# the one knob that can quietly undo the point of the tool.
# COMPASS_QUALITY_WINDOW=5
# COMPASS_TEMPLATED_THRESHOLD=0.85
